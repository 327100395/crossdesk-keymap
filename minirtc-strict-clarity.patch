diff --git a/src/transport/strict_clarity_policy.h b/src/transport/strict_clarity_policy.h
new file mode 100644
--- /dev/null
+++ b/src/transport/strict_clarity_policy.h
@@ -0,0 +1,21 @@
+#ifndef MINIRTC_STRICT_CLARITY_POLICY_H_
+#define MINIRTC_STRICT_CLARITY_POLICY_H_
+#include <algorithm>
+#include <cstdint>
+#include <cmath>
+namespace minirtc {
+inline int StrictClarityFps(int bitrate, int width, int height, int ceiling) {
+  ceiling = std::clamp(ceiling, 1, 30);
+  const double pixels = static_cast<double>(std::max(1, width)) * std::max(1, height);
+  // Reserve around 0.08 bits/pixel/frame for desktop detail. This is an
+  // admission estimate, not a promise about visual quality.
+  const double fps = std::max(0, bitrate) / (pixels * 0.08);
+  return std::max(1, static_cast<int>(std::min<double>(ceiling, fps)));
+}
+inline bool StrictClarityAcceptsQp(bool available, float normalized_qp) {
+  // Conservative H264/AV1 normalized QP proxy; unknown quality is not verified.
+  return available && std::isfinite(normalized_qp) && normalized_qp >= 0 &&
+         normalized_qp <= 0.55f;
+}
+}
+#endif
