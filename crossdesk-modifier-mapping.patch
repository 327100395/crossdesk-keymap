diff --git a/apps/desktop/tests/modifier_mapping_test.cpp b/apps/desktop/tests/modifier_mapping_test.cpp
new file mode 100644
--- /dev/null
+++ b/apps/desktop/tests/modifier_mapping_test.cpp
@@ -0,0 +1,60 @@
+#include "../src/config_center/modifier_mapping.h"
+
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <iostream>
+#include <set>
+
+using namespace crossdesk;
+
+struct Key {
+  std::size_t key_value;
+  uint32_t scan_code;
+  bool extended;
+};
+
+int main() {
+  constexpr std::size_t keys[4][2] = {
+      {0xa2, 0xa3}, {0x5b, 0x5c}, {0xa4, 0xa5}, {0xa0, 0xa1}};
+  constexpr uint32_t scan[4][2] = {
+      {0x1d, 0x1d}, {0x5b, 0x5c}, {0x38, 0x38}, {0x2a, 0x36}};
+  constexpr bool ext[4][2] = {
+      {false, true}, {true, true}, {false, true}, {false, false}};
+  auto mapping = kDefaultModifierMapping;
+  int permutations = 0;
+  do {
+    assert(ValidModifierMapping(mapping));
+    std::set<std::size_t> resulting_keys;
+    for (int source = 0; source < 4; ++source) {
+      for (int side = 0; side < 2; ++side) {
+        Key event{keys[source][side], scan[source][side], ext[source][side]};
+        Key heartbeat = event;
+        MapModifierKey(event, mapping);
+        MapModifierKey(heartbeat, mapping);
+        assert(event.key_value == keys[mapping[source]][side]);
+        assert(event.scan_code == scan[mapping[source]][side]);
+        assert(event.extended == ext[mapping[source]][side]);
+        assert(heartbeat.key_value == event.key_value);
+        assert(heartbeat.scan_code == event.scan_code);
+        assert(heartbeat.extended == event.extended);
+        assert(resulting_keys.insert(event.key_value).second);
+      }
+      for (int target = 0; target < 4; ++target) {
+        auto next = ChooseModifier(mapping, source, target);
+        assert(ValidModifierMapping(next));
+        assert(next[source] == target);
+      }
+    }
+    Key letter{0x41, 0x1e, false};
+    MapModifierKey(letter, mapping);
+    assert(letter.key_value == 0x41 && letter.scan_code == 0x1e && !letter.extended);
+    ++permutations;
+  } while (std::next_permutation(mapping.begin(), mapping.end()));
+  assert(permutations == 24);
+  assert(!ValidModifierMapping({0, 0, 2, 3}));
+  assert(!ValidModifierMapping({-1, 1, 2, 3}));
+  assert(!ValidModifierMapping({0, 1, 2, 4}));
+  assert((ChooseModifier(kDefaultModifierMapping, 0, 1) == ModifierMapping{1, 0, 2, 3}));
+  std::cout << "Passed all 24 mappings, 8 left/right keys, heartbeat consistency and validation.\n";
+}
