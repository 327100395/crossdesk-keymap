+#ifndef CROSSDESK_MODIFIER_MAPPING_H_
+#define CROSSDESK_MODIFIER_MAPPING_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+
+namespace crossdesk {
+// Order: Control, Windows/Command, Alt/Option, Shift.
+using ModifierMapping = std::array<int, 4>;
+inline constexpr ModifierMapping kDefaultModifierMapping{{0, 1, 2, 3}};
+
+inline bool ValidModifierMapping(const ModifierMapping& mapping) {
+  unsigned seen = 0;
+  for (int target : mapping) {
+    if (target < 0 || target >= 4 || (seen & (1u << target))) return false;
+    seen |= 1u << target;
+  }
+  return true;
+}
+
+// Selecting an occupied target swaps the two assignments; no collisions.
+inline ModifierMapping ChooseModifier(ModifierMapping mapping, int source, int target) {
+  if (!ValidModifierMapping(mapping) || source < 0 || source >= 4 ||
+      target < 0 || target >= 4) return mapping;
+  for (int i = 0; i < 4; ++i) {
+    if (mapping[i] == target) {
+      std::swap(mapping[source], mapping[i]);
+      break;
+    }
+  }
+  return mapping;
+}
+
+template <typename Key>
+inline void MapModifierKey(Key& key, const ModifierMapping& mapping) {
+  // CrossDesk's existing wire representation uses Windows virtual key values.
+  constexpr std::size_t vk[4][2] = {{0xa2, 0xa3}, {0x5b, 0x5c},
+                                   {0xa4, 0xa5}, {0xa0, 0xa1}};
+  constexpr uint32_t scan[4][2] = {{0x1d, 0x1d}, {0x5b, 0x5c},
+                                   {0x38, 0x38}, {0x2a, 0x36}};
+  constexpr bool extended[4][2] = {{false, true}, {true, true},
+                                    {false, true}, {false, false}};
+  if (!ValidModifierMapping(mapping)) return;
+  for (int source = 0; source < 4; ++source) {
+    for (int side = 0; side < 2; ++side) {
+      if (key.key_value != vk[source][side]) continue;
+      const int target = mapping[source];
+      if (source != target) {
+        key.key_value = vk[target][side];
+        key.scan_code = scan[target][side];
+        key.extended = extended[target][side];
+      }
+      return;
+    }
+  }
+}
+}  // namespace crossdesk
+#endif
