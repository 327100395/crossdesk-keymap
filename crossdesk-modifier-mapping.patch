+ModifierMapping ConfigCenter::GetModifierMapping(const std::string& device) const {
+  std::lock_guard lock(modifier_mapping_mutex_);
+  const auto found = device_modifier_mappings_.find(device);
+  return found == device_modifier_mappings_.end() ? kDefaultModifierMapping : found->second;
+}
+
+int ConfigCenter::SetModifierMapping(const std::string& device,
+                                     const ModifierMapping& mapping) {
+  if (device.empty() || !ValidModifierMapping(mapping)) return -1;
+  std::lock_guard lock(modifier_mapping_mutex_);
+  auto mappings = device_modifier_mappings_;
+  if (mapping == kDefaultModifierMapping) mappings.erase(device);
+  else mappings[device] = mapping;
+  if (StoreValues({{"device_modifier_mappings", nlohmann::json(mappings).dump()}}) != 0)
+    return -1;
+  device_modifier_mappings_ = std::move(mappings);
+  return 0;
+}
